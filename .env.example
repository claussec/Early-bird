# demo | anthropic | ollama
LLM_PROVIDER=demo

# Claude (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Local / offline LLM (LLM_PROVIDER=ollama)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Live web crawling in the External Module (website + Google News RSS)
CRAWLER_ENABLED=false

# Pause between pipeline steps in demo mode (seconds), so the workflow is visible in the UI
DEMO_STEP_DELAY=0.6
