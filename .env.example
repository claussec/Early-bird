# --- KI-Agenten ----------------------------------------------------------------
# demo | anthropic | ollama
LLM_PROVIDER=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Lokales / Offline-LLM (LLM_PROVIDER=ollama)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Live-Web-Crawling im External Module (Website + Google News RSS)
CRAWLER_ENABLED=false

# Leere Datenbank beim ersten Start mit fiktiven Demo-Lieferanten füllen
SEED_DEMO_DATA=true
# Pause zwischen den Pipeline-Schritten im Demo-Modus (Sekunden)
DEMO_STEP_DELAY=0.6

# Basis-URL der App (für Links in Mails und Teams-Karten)
APP_BASE_URL=http://localhost:8000

# --- Quellsysteme ----------------------------------------------------------------
# SAP S/4HANA (OData API_BUSINESS_PARTNER)
SAP_BASE_URL=
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=
# Beliebiges weiteres System über REST (siehe README → Quellsysteme)
ERP_NAME=ERP (REST)
ERP_BASE_URL=
ERP_TOKEN=

# --- Microsoft 365 -------------------------------------------------------------
# Outlook über Microsoft Graph (App-Registrierung mit Application-Permission Mail.Send)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
OUTLOOK_SENDER=
# Teams-Kanal über Workflows-Webhook ("Post to a channel when a webhook request is received")
TEAMS_WEBHOOK_URL=

# --- Automode ------------------------------------------------------------------
# Startwerte; zur Laufzeit im Cockpit oder über /api/automode änderbar
AUTOMODE_ENABLED=false
AUTOMODE_INTERVAL_MINUTES=1440
AUTOMODE_CHANNELS=outlook,teams

# Sprache der generierten Texte und E-Mails, wenn der Client keine angibt (de | en)
DEFAULT_LANG=de

# Geokodierung von Lieferanten- und Werksadressen für die 3D-Karte:
#   offline   = Stadt/Land aus data/gazetteer.json (GeoNames, CC BY 4.0), keine Netzwerkzugriffe
#   nominatim = OpenStreetMap Nominatim, straßengenau (Nutzungsbedingungen beachten, max. 1 Anfrage/s)
GEOCODER=offline
